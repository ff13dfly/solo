# Solo Core
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=<random-hex-32-bytes>        # init.sh 自动生成

# Router Identity
# init.sh 自动生成 .keypair 并填入下面两项，无需手动编辑。
# 手动轮换密钥时：重新生成 .keypair，同步更新 ROUTER_PUBLIC_KEY，重启所有服务。
SOLO_KEYPAIR_PATH=/path/to/project/.keypair
ROUTER_PUBLIC_KEY=<base58-public-key>

# Router 静态资源
# 新项目走 OSS，关闭 Router 的本地文件服务（避免它尝试解析不存在的 /uploads/assets）
ENABLE_STATIC_ASSETS=false

# 监听网卡（可选，opt-in 加固）
# 不设 = 保持默认行为：每个进程绑所有网卡（机器一有公网 IP，服务当场对全网可达）。
# 设了就对**全部 Solo 进程生效，含 Router**；单独放行某一个用 <服务名大写>_BIND_ADDR。
#   BIND_ADDR=127.0.0.1        # 全锁进 loopback（反代与本机同机时的正确形态）
#   ROUTER_BIND_ADDR=0.0.0.0   # 只把唯一入口放出去
# ⚠️ 反代/LB/容器网络是从**别的主机**打进来时，别把那个服务锁到 127.0.0.1。
# 详见 docs/authoring/service.md「监听网卡」。

# RediSearch（可选，只在 config.indexes 非空时才有意义）
# 通配/中缀查询（`@field:{*词*}`）能展开多少个不同的词。RediSearch 默认 200，
# **超限不报错、不告警，只是少返回几行** —— 而截断量与命中通配的词数成正比，
# 所以冷门词永远正确、高频词悄悄丢，开发期小样本看不出来。indexer 默认把它设成
# 200000。取值范围 >= 1（0 与 -1 都会被 RediSearch 拒绝，MAXSEARCHRESULTS
# 那套 -1 = 无限的约定在这里不成立）。
# REDISEARCH_MAXPREFIXEXPANSIONS=200000
#
# 中文文本字段要在 config.indexes 里写 language: 'chinese'，否则默认分词器
# 把整串中文当一个 token，命中 0 条。详见 docs/authoring/service.md §6.7。

# 外部存储（可选，框架自身不消费——放在这里是为了说明这条路是允许的）
# 业务行的主要查询形态是多维筛选 / JOIN / 聚合报表时，Redis 不匹配，那几张表可以落
# PostgreSQL 等外部库；框架实体（category/config/session/任务队列）仍留在 Redis。
# 走法是在 logic 文件里写一行 `// SAFE: external-store` 显式声明豁免门禁，
# 并自己接回 $owner 行隔离、sensitiveFields 掩码、WAL 审计。
# 判据与代价见 docs/authoring/service.md §6.8。变量名由你的服务自己定义和读取：
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/dbname

# Optional
# LOG_LEVEL=info
# NODE_ENV=production
# SYSTEM_DISPLAY_NAME=SYSTEM   # 管理后台左上角 / 登录页标题前缀，多实例部署时用来区分（默认 SYSTEM）
# SYSTEM_DESCRIPTION=这是 XXX 项目的生产网关，负责 XXX。   # Overview 页说明卡片文案，单行；不设置则显示通用占位文案
